%%{init: {'themeVariables': { 'fontSize': '12px'}}}%%
graph TD
    classDef path fill:#eee,stroke:#000,color:#000
    classDef plan fill:#fff,stroke-width:1px,color:#000
    classDef itemplan fill:#fff,stroke-width:2px,color:#000
    classDef unbatchedplan fill:#dff,stroke-width:1px,color:#000
    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/connections/custom-query-user-visible-messages"
    Bucket0("Bucket 0 (root)<br /><br />1: PgSelectInlineApply[27]<br />ᐳ: Access[7], Access[8], Object[9]<br />2: PgSelect[6]<br />ᐳ: Access[28]<br />3: PgSelectRows[11]<br />ᐳ: 10, 12, 29, 30"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 30, 12<br /><br />ROOT PgSelectSingleᐸusersᐳ[12]<br />1: Connection[17]<br />2: ConnectionItems[19]"):::bucket
    Bucket2("Bucket 2 (nullableBoundary)<br />Deps: 17, 19<br /><br />ROOT Connection{1}ᐸ30ᐳ[17]"):::bucket
    Bucket4("Bucket 4 (listItem)<br /><br />ROOT __Item{4}ᐸ19ᐳ[23]"):::bucket
    Bucket5("Bucket 5 (nullableBoundary)<br />Deps: 23, 24<br /><br />ROOT Edge{4}[24]"):::bucket
    Bucket6("Bucket 6 (nullableBoundary)<br />Deps: 25<br /><br />ROOT PgSelectSingle{5}ᐸmessagesᐳ[25]"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket2
    Bucket2 --> Bucket4
    Bucket4 --> Bucket5
    Bucket5 --> Bucket6

    %% plan dependencies
    PgSelect6[["PgSelect[6∈0] ➊<br />ᐸrandom_userᐳ"]]:::plan
    Object9{{"Object[9∈0] ➊<br />ᐸ{pgSettings,withPgClient}ᐳ"}}:::plan
    PgSelectInlineApply27["PgSelectInlineApply[27∈0] ➊"]:::plan
    Object9 & PgSelectInlineApply27 --> PgSelect6
    Access7{{"Access[7∈0] ➊<br />ᐸ2.pgSettingsᐳ"}}:::plan
    Access8{{"Access[8∈0] ➊<br />ᐸ2.withPgClientᐳ"}}:::plan
    Access7 & Access8 --> Object9
    List29{{"List[29∈0] ➊<br />ᐸ28,10ᐳ"}}:::plan
    Access28{{"Access[28∈0] ➊<br />ᐸ6.m.subqueryDetailsFor13ᐳ"}}:::plan
    First10{{"First[10∈0] ➊"}}:::plan
    Access28 & First10 --> List29
    __Value2["__Value[2∈0] ➊<br />ᐸcontextᐳ"]:::plan
    __Value2 --> Access7
    __Value2 --> Access8
    PgSelectRows11[["PgSelectRows[11∈0] ➊"]]:::plan
    PgSelectRows11 --> First10
    PgSelect6 --> PgSelectRows11
    PgSelect6 --> Access28
    Lambda30{{"Lambda[30∈0] ➊<br />ᐸpgInlineViaSubqueryTransformᐳ"}}:::plan
    List29 --> Lambda30
    Connection17[["Connection[17∈1] ➊<br />ᐸ30ᐳ"]]:::plan
    Lambda30 --> Connection17
    ConnectionItems19[["ConnectionItems[19∈1] ➊"]]:::plan
    Connection17 --> ConnectionItems19
    __Item23[/"__Item[23∈4]<br />ᐸ19ᐳ"\]:::itemplan
    ConnectionItems19 ==> __Item23
    Edge24{{"Edge[24∈4]"}}:::plan
    __Item23 --> Edge24
    PgSelectSingle25{{"PgSelectSingle[25∈5]<br />ᐸmessagesᐳ"}}:::plan
    __Item23 --> PgSelectSingle25
    PgClassExpression26{{"PgClassExpression[26∈6]<br />ᐸ__messages__.”id”ᐳ"}}:::plan
    PgSelectSingle25 --> PgClassExpression26

    %% define steps
    classDef bucket0 stroke:#696969
    class Bucket0,__Value2,PgSelect6,Access7,Access8,Object9,First10,PgSelectRows11,PgSelectInlineApply27,Access28,List29,Lambda30 bucket0
    classDef bucket1 stroke:#00bfff
    class Bucket1,Connection17,ConnectionItems19 bucket1
    classDef bucket2 stroke:#7f007f
    class Bucket2 bucket2
    classDef bucket4 stroke:#0000ff
    class Bucket4,__Item23,Edge24 bucket4
    classDef bucket5 stroke:#7fff00
    class Bucket5,PgSelectSingle25 bucket5
    classDef bucket6 stroke:#ff1493
    class Bucket6,PgClassExpression26 bucket6

