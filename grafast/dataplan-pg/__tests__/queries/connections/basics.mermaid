    subgraph "Buckets for queries/connections/basics"
    Bucket0("Bucket 0 (root)<br /><br />1: PgSelectInlineApply[48]<br />ᐳ: 9, 10, 52, 11, 14<br />2: PgSelect[8], PgSelect[19]<br />ᐳ: Access[30], Access[49]<br />3: Connection[12], PgSelectRows[21]<br />ᐳ: 20, 22, 23<br />4: ConnectionItems[15]<br />5: First[29], Last[32]<br />ᐳ: PgCursor[31], PgCursor[33]"):::bucket
