%%{init: {'themeVariables': { 'fontSize': '12px'}}}%%
graph TD
    classDef path fill:#eee,stroke:#000,color:#000
    classDef plan fill:#fff,stroke-width:1px,color:#000
    classDef itemplan fill:#fff,stroke-width:2px,color:#000
    classDef unbatchedplan fill:#dff,stroke-width:1px,color:#000
    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/polymorphic/person-app-vulns.app-totalCount"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 10, 11, 33, 35, 12<br />2: PgSelect[9]<br />3: Connection[13]<br />4: ConnectionItems[15]"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 13, 15, 12, 33<br /><br />ROOT Connectionᐸ9ᐳ[13]"):::bucket
    Bucket3("Bucket 3 (listItem)<br />Deps: 12, 33<br /><br />ROOT __Item{3}ᐸ15ᐳ[19]"):::bucket
    Bucket4("Bucket 4 (nullableBoundary)<br />Deps: 20, 12, 33<br /><br />ROOT PgSelectSingle{3}ᐸpeopleᐳ[20]<br />1: <br />ᐳ: 21, 22<br />2: PgUnionAll[28]<br />ᐳ: 34, 29, 32"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket3
    Bucket3 --> Bucket4

    %% plan dependencies
    PgSelect9[["PgSelect[9∈0] ➊<br />ᐸpeopleᐳ<br />More deps:<br />- Object[12]<br />- Constantᐸ4ᐳ[35]"]]:::plan
    Object12{{"Object[12∈0] ➊<br />ᐸ{pgSettings,withPgClient}ᐳ<br />Dependents: 2"}}:::plan
    Access10{{"Access[10∈0] ➊<br />ᐸ2.pgSettingsᐳ"}}:::plan
    Access11{{"Access[11∈0] ➊<br />ᐸ2.withPgClientᐳ"}}:::plan
    Access10 & Access11 --> Object12
    Connection13[["Connection[13∈0] ➊<br />ᐸ9ᐳ<br />More deps:<br />- Constantᐸ4ᐳ[35]"]]:::plan
    PgSelect9 --> Connection13
    __Value2["__Value[2∈0] ➊<br />ᐸcontextᐳ"]:::plan
    __Value2 --> Access10
    __Value2 --> Access11
    ConnectionItems15[["ConnectionItems[15∈0] ➊"]]:::plan
    Connection13 --> ConnectionItems15
    __Item19[/"__Item[19∈3]<br />ᐸ15ᐳ"\]:::itemplan
    ConnectionItems15 ==> __Item19
    PgSelectSingle20{{"PgSelectSingle[20∈3]<br />ᐸpeopleᐳ"}}:::plan
    __Item19 --> PgSelectSingle20
    PgUnionAll28[["PgUnionAll[28∈4]<br />ᐸAwsApplication,GcpApplicationᐳ<br />More deps:<br />- Object[12]"]]:::plan
    PgClassExpression21{{"PgClassExpression[21∈4]<br />ᐸ__people__.”person_id”ᐳ"}}:::plan
    PgClassExpression21 --> PgUnionAll28
    PgSelectSingle20 --> PgClassExpression21
    PgClassExpression22{{"PgClassExpression[22∈4]<br />ᐸ__people__.”username”ᐳ"}}:::plan
    PgSelectSingle20 --> PgClassExpression22
    First29{{"First[29∈4]"}}:::plan
    Access34{{"Access[34∈4]<br />ᐸ28.itemsᐳ"}}:::plan
    Access34 --> First29
    PgClassExpression32{{"PgClassExpression[32∈4]<br />ᐸcount(*)ᐳ"}}:::plan
    First29 --> PgClassExpression32
    PgUnionAll28 --> Access34

    %% define steps
    classDef bucket0 stroke:#696969
    class Bucket0,__Value2,PgSelect9,Access10,Access11,Object12,Connection13,ConnectionItems15 bucket0
    classDef bucket1 stroke:#00bfff
