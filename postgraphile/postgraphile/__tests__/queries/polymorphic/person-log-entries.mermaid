    ConnectionItems14[["ConnectionItems[14∈0] ➊"]]:::plan
    Connection12 --> ConnectionItems14
    Access21{{"Access[21∈0] ➊<br />ᐸ8.cursorDetailsᐳ"}}:::plan
    PgSelect8 --> Access21
    Access36{{"Access[36∈0] ➊<br />ᐸ8.m.subqueryDetailsFor24ᐳ"}}:::plan
    PgSelect8 --> Access36
    __CloneStream17[["__CloneStream[17∈1] ➊"]]:::plan
    ConnectionItems14 --> __CloneStream17
    Edge19{{"Edge[19∈3]"}}:::plan
    __Item18[/"__Item[18∈3]<br />ᐸ17ᐳ"\]:::itemplan
