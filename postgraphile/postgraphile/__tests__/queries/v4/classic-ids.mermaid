    subgraph "Buckets for queries/v4/classic-ids"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 6, 11, 12, 37, 43, 44, 7, 13, 15, 17, 23<br />2: PgSelect[10], PgSelect[20]<br />3: Connection[14], Connection[22]<br />4: 25, 28"):::bucket
