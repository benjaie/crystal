%%{init: {'themeVariables': { 'fontSize': '12px'}}}%%
graph TD
    classDef path fill:#eee,stroke:#000,color:#000
    classDef plan fill:#fff,stroke-width:1px,color:#000
    classDef itemplan fill:#fff,stroke-width:2px,color:#000
    classDef unbatchedplan fill:#dff,stroke-width:1px,color:#000
    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/v4/nested_arrays.select"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 9, 10, 30, 11<br />2: PgSelect[8]<br />3: Connection[12]<br />4: ConnectionItems[14]"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 14, 12, 11, 30<br /><br />ROOT Connectionᐸ8ᐳ[12]"):::bucket
    Bucket3("Bucket 3 (listItem)<br />Deps: 11, 30<br /><br />ROOT __Item{3}ᐸ17ᐳ[18]"):::bucket
    Bucket4("Bucket 4 (nullableBoundary)<br />Deps: 19, 11, 30<br /><br />ROOT PgSelectSingle{3}ᐸtᐳ[19]"):::bucket
    Bucket6("Bucket 6 (listItem)<br />Deps: 11, 30<br /><br />ROOT __Item{6}ᐸ21ᐳ[25]<br />1: PgSelect[26]<br />2: PgSelectRows[31]"):::bucket
    Bucket7("Bucket 7 (listItem)<br /><br />ROOT __Item{7}ᐸ31ᐳ[33]"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket3
    Bucket3 --> Bucket4
    Bucket4 --> Bucket6
    Bucket6 --> Bucket7

    %% plan dependencies
    Object11{{"Object[11∈0] ➊<br />ᐸ{pgSettings,withPgClient}ᐳ<br />Dependents: 2"}}:::plan
    Access9{{"Access[9∈0] ➊<br />ᐸ2.pgSettingsᐳ"}}:::plan
    Access10{{"Access[10∈0] ➊<br />ᐸ2.withPgClientᐳ"}}:::plan
    Access9 & Access10 --> Object11
    PgSelect8[["PgSelect[8∈0] ➊<br />ᐸtᐳ<br />More deps:<br />- Object[11]"]]:::plan
    __Value2["__Value[2∈0] ➊<br />ᐸcontextᐳ"]:::plan
    __Value2 --> Access9
    __Value2 --> Access10
    Connection12[["Connection[12∈0] ➊<br />ᐸ8ᐳ"]]:::plan
    PgSelect8 --> Connection12
    ConnectionItems14[["ConnectionItems[14∈0] ➊"]]:::plan
    Connection12 --> ConnectionItems14
    PgFromExpression30{{"PgFromExpression[30∈0] ➊"}}:::plan
    __CloneStream17[["__CloneStream[17∈1] ➊"]]:::plan
    ConnectionItems14 --> __CloneStream17
    __Item18[/"__Item[18∈3]<br />ᐸ17ᐳ"\]:::itemplan
    __CloneStream17 ==> __Item18
    PgSelectSingle19{{"PgSelectSingle[19∈3]<br />ᐸtᐳ"}}:::plan
    __Item18 --> PgSelectSingle19
    PgClassExpression20{{"PgClassExpression[20∈4]<br />ᐸ__t__.”k”ᐳ"}}:::plan
    PgSelectSingle19 --> PgClassExpression20
    PgClassExpression21{{"PgClassExpression[21∈4]<br />ᐸ__t__.”v”ᐳ"}}:::plan
    PgSelectSingle19 --> PgClassExpression21
    PgSelect26[["PgSelect[26∈6]<br />ᐸfrmcdc_workHourᐳ<br />More deps:<br />- Object[11]"]]:::plan
    __Item25[/"__Item[25∈6]<br />ᐸ21ᐳ"\]:::itemplan
    __Item25 & PgFromExpression30 --> PgSelect26
    PgClassExpression21 ==> __Item25
    PgSelectRows31[["PgSelectRows[31∈6]"]]:::plan
    PgSelect26 --> PgSelectRows31
    __Item33[/"__Item[33∈7]<br />ᐸ31ᐳ"\]:::itemplan
    PgSelectRows31 ==> __Item33
    PgSelectSingle34{{"PgSelectSingle[34∈7]<br />ᐸfrmcdc_workHourᐳ"}}:::plan
    __Item33 --> PgSelectSingle34
    PgClassExpression35{{"PgClassExpression[35∈7]<br />ᐸ__frmcdc_w...rom_hours”ᐳ"}}:::plan
    PgSelectSingle34 --> PgClassExpression35
    PgClassExpression36{{"PgClassExpression[36∈7]<br />ᐸ__frmcdc_w...m_minutes”ᐳ"}}:::plan
    PgClassExpression35 o--o PgClassExpression36
    PgClassExpression37{{"PgClassExpression[37∈7]<br />ᐸ__frmcdc_w...”to_hours”ᐳ"}}:::plan
    PgClassExpression36 o--o PgClassExpression37
    PgClassExpression38{{"PgClassExpression[38∈7]<br />ᐸ__frmcdc_w...o_minutes”ᐳ"}}:::plan
    PgClassExpression37 o--o PgClassExpression38

    %% define steps
    classDef bucket0 stroke:#696969
    class Bucket0,__Value2,PgSelect8,Access9,Access10,Object11,Connection12,ConnectionItems14,PgFromExpression30 bucket0
    classDef bucket1 stroke:#00bfff
    class Bucket1,__CloneStream17 bucket1
    classDef bucket3 stroke:#ffa500
    class Bucket3,__Item18,PgSelectSingle19 bucket3
    classDef bucket4 stroke:#0000ff
    class Bucket4,PgClassExpression20,PgClassExpression21 bucket4
    classDef bucket6 stroke:#ff1493
    class Bucket6,__Item25,PgSelect26,PgSelectRows31 bucket6
    classDef bucket7 stroke:#808000
    class Bucket7,__Item33,PgSelectSingle34,PgClassExpression35,PgClassExpression36,PgClassExpression37,PgClassExpression38 bucket7

