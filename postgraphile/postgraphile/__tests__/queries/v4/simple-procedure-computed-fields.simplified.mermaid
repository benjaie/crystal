    Bucket4("Bucket 4 (nullableBoundary)<br />Deps: 19, 44, 41, 18<br /><br />ROOT PgSelectSingle{3}ᐸpersonᐳ[19]<br />1: <br />ᐳ: 20, 42, 43<br />2: Connection[28]<br />3: ConnectionItems[30]"):::bucket
