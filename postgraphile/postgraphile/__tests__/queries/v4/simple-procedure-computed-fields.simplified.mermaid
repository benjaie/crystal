    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/v4/simple-procedure-computed-fields.simplified"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 6, 9, 10, 44, 11, 38<br />2: PgSelectInlineApply[40]<br />3: PgSelect[8]<br />ᐳ: Access[41]<br />4: Connection[12]<br />5: ConnectionItems[14]"):::bucket
